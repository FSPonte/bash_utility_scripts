#!/usr/bin/env bash

# Color codes
RESET="\x1b[0m"
RED="\x1b[1;31m"
YELLOW="\x1b[1;33m"
BLUE="\x1b[1;34m"

# Name of the lock file
LOCK_FILE="/tmp/update.lock"

# --- Handle cleanup ---

cleanup() {
	if [ -e  "$LOCK_FILE" ]; then
		rm -f "$LOCK_FILE"
	fi

	exit 1
}

trap cleanup EXIT

# --- Handle lock file ---

if [ -e "$LOCK_FILE" ]; then
	echo -e "$RED[ERROR]$RESET Script is already running or lock file exists"
	echo -e "        Lock file: $LOCK_FILE"
	echo -e "        Remove lock file: rm -f $LOCK_FILE"

	exit 1
fi

touch "$LOCK_FILE"

# --- Commands ---

echo -e "$BLUE--- Updating the index ---$RESET"
sudo apt-get update

echo -e "\n$BLUE--- Upgrading packages ---$RESET"
sudo apt-get full-upgrade -y

echo -e "\n$BLUE--- Removing unused packages ---$RESET"
sudo apt-get autoremove -y

echo -e "\n$BLUE--- Fixing broken packages ---$RESET"
sudo apt-get install -f

echo -e "\n$BLUE--- Cleaning cache ---$RESET"
sudo apt-get autoclean
